[resource]
script = ExtResource("1_rr0wt")
id = &"electrical_engineering"
display_name = "Electrical Engineering"
description = "- Rank 1: Unlocks the Rewire Kit, used to bypass certain electronic security measures.
- Rank 2: Allows the player to overload power boxes. Overloading a power box will destroy it but will not cause a \"Power Unrestored\" alert level increase if reported. Also unlocks the EMP, which can destroy nearby electronics.
- Rank 3: The Rewire Kit can be used on more advanced and uncommon security measures."
major_skill = true
